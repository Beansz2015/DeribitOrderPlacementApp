<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows8.0</TargetFramework>
	  <ContinuousIntegrationBuild>false</ContinuousIntegrationBuild>
	  <UseWindowsForms>true</UseWindowsForms>
    <MyType>WindowsForms</MyType>
    <StartupObject>DeribitOrderPlacementApp.My.MyApplication</StartupObject>
    <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <Import Include="System.Data" />
    <Import Include="System.Drawing" />
    <Import Include="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <!-- OrderCheck logic harness (tools/OrderCheck): fixtures run against the Friend seams. -->
    <InternalsVisibleTo Include="OrderCheck" />
  </ItemGroup>

	<ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="System.Data.SQLite" Version="1.0.119" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="My Project\Application.Designer.vb">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Application.myapp</DependentUpon>
    </Compile>
    <Compile Update="My Project\Resources.Designer.vb">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="My Project\Resources.resx">
      <CustomToolNamespace>My.Resources</CustomToolNamespace>
      <Generator>VbMyResourcesResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.vb</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <None Update="My Project\Application.myapp">
      <Generator>MyApplicationCodeGenerator</Generator>
      <LastGenOutput>Application.Designer.vb</LastGenOutput>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!-- Local, git-ignored secrets. Copied to output only if present (fresh clones build fine without it). -->
    <None Update="secrets.json" Condition="Exists('secrets.json')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="secrets.example.json">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </None>
    <!-- Local, git-ignored signal-bridge config. Copied to output only if present (defaults apply without it). -->
    <None Update="bridge.json" Condition="Exists('bridge.json')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="bridge.example.json">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </None>
    <None Update="bridge-state.example.json">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </None>
    <!-- Local, git-ignored trade defaults (ergonomics item A). Copied to output only if present (Designer defaults apply without it). -->
    <None Update="orderapp-settings.json" Condition="Exists('orderapp-settings.json')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="orderapp-settings.example.json">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </None>
    <!-- Local, git-ignored UI-test-harness config. Copied to output only if present (hooks stay dormant without it). -->
    <None Update="harness.json" Condition="Exists('harness.json')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="harness.example.json">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>